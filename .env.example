# Copy to .env.local and fill in. Never commit real values.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# --- Walrus Memory: memory.walrus.xyz, MAINNET account ---
# Delegate private key (hex)
MEMWAL_KEY=
# Account OBJECT ID, not your wallet address (a wrong value gives a 401)
MEMWAL_ACCOUNT_ID=
# Delegate PUBLIC key (64 hex), also needed for the submission form
MEMWAL_AGENT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# --- Tatum: dashboard API key ---
TATUM_API_KEY=
TATUM_SUI_GRAPHQL=https://sui-mainnet.gateway.tatum.io/graphql
TATUM_SUI_GRPC=https://sui-mainnet-grpc.gateway.tatum.io

# --- Google Cloud: OAuth client, Testing mode, gmail.readonly ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram: @BotFather ---
TELEGRAM_BOT_TOKEN=

# --- LLM: Anthropic Console, used with claude-haiku-5-5 ---
LLM_API_KEY=

# --- Neon Postgres: connection string ---
DATABASE_URL=

# --- Generated locally: openssl rand -hex 32 ---
# AES-GCM key for Google refresh tokens
TOKEN_ENC_KEY=
# Namespaces derive from this. Back it up, and never change it once real data exists.
NS_SALT=
# Protects the cron endpoints
CRON_SECRET=
