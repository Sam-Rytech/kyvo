{
  "name": "kyvo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "probe:memwal": "node --env-file=.env.local --import tsx scripts/probe-memwal.ts",
    "probe:tatum": "node --env-file=.env.local --import tsx scripts/probe-tatum.ts",
    "eval:extractor": "node --env-file=.env.local --import tsx scripts/eval-extractor.ts",
    "export:fixtures": "node --env-file=.env.local --import tsx scripts/export-fixtures.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.76",
    "@mysten-incubation/memwal": "0.1.13",
    "@mysten/dapp-kit-react": "2.1.44",
    "@mysten/seal": "^1.5.3",
    "@mysten/sui": "^2.39.0",
    "@mysten/walrus": "^1.2.38",
    "@neondatabase/serverless": "1.2.0",
    "ai": "^7.0.162",
    "drizzle-orm": "0.45.4",
    "grammy": "1.46.0",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
